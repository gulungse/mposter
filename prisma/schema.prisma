generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String          @id @default(uuid())
  email                    String          @unique
  name                     String?
  image                    String?
  role                     UserRole        @default(USER)
  tokenBalance             Int             @default(0)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  planId                   String?
  subscriptionEnd          DateTime?
  emailVerifiedAt          DateTime?
  verificationBonusClaimed Boolean         @default(false)
  limits                   Json?
  settings                 Json?
  hasImageGenRights        Boolean         @default(false)
  automationJobs           AutomationJob[]
  keywordGroups            KeywordGroup[]
  payments                 Payment[]
  postLogs                 PostLog[]
  prompts                  Prompt[]
  sites                    Site[]
  transactions             Transaction[]
  purchases                UserPurchase[]
  plan                     Plan?           @relation(fields: [planId], references: [id])

  @@map("users")
}

model WithdrawnUser {
  id          String   @id @default(uuid())
  email       String   @unique
  withdrawnAt DateTime @default(now())
  availableAt DateTime

  @@map("withdrawn_users")
}

model Plan {
  id                String   @id @default(uuid())
  name              String
  price             Int      @default(0)
  siteLimit         Int      @default(2)
  keywordGroupLimit Int      @default(3)
  promptLimit       Int      @default(2)
  taskLimit         Int      @default(2)
  description       String?
  monthlyTokens     Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  users             User[]

  @@map("plans")
}

model Site {
  id           String          @id @default(uuid())
  userId       String
  type         SiteType
  name         String
  url          String
  username     String?
  apiToken     String?
  refreshToken String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  jobs         AutomationJob[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sites")
}

model KeywordGroup {
  id        String          @id @default(uuid())
  userId    String
  name      String
  keywords  String[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  jobs      AutomationJob[]
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("keyword_groups")
}

model Prompt {
  id        String          @id @default(uuid())
  userId    String?
  type      PromptType      @default(USER)
  title     String
  content   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  jobs      AutomationJob[]
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("prompts")
}

model AutomationJob {
  id                String        @id @default(uuid())
  userId            String
  name              String
  siteId            String
  keywordGroupId    String?
  keywords          String[]
  promptId          String?
  scheduleCron      String?
  aiModel           AIModel       @default(GPT4O)
  imageSource       ImageSource   @default(DALLE)
  imageCount        Int           @default(1)
  isActive          Boolean       @default(true)
  wpCategoryId      Int?
  wpCategoryName    String?
  postStatus        String        @default("publish")
  lastRunAt         DateTime?
  nextRunAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  advContentPhraseA String?
  advContentPhraseB String?
  advThumbnailLines String[]
  advImageMode      String?   @default("STANDARD")
  advCustomImages   String[]
  advNextImageIdx   Int       @default(0)
  keywordGroup      KeywordGroup? @relation(fields: [keywordGroupId], references: [id], onDelete: Cascade)
  prompt            Prompt?       @relation(fields: [promptId], references: [id])
  site              Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs              PostLog[]

  @@map("automation_jobs")
}

model PostLog {
  id           String         @id @default(uuid())
  userId       String
  jobId        String?
  keyword      String
  title        String?
  status       PostStatus     @default(PENDING)
  postUrl      String?
  tokensUsed   Int            @default(0)
  errorMessage String?
  createdAt    DateTime       @default(now())
  seed         Int?
  job          AutomationJob? @relation(fields: [jobId], references: [id])
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("post_logs")
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  amount      Int
  description String
  type        TransactionType
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transactions")
}

model SidebarMenu {
  id        String   @id @default(uuid())
  label     String
  href      String
  icon      String   @default("LayoutDashboard")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sidebar_menus")
}

model GlobalSetting {
  id                 String   @id @default("SYSTEM")
  costPerPost        Int      @default(1)
  costPerScrap       Int      @default(1)
  costPerAIImage     Int      @default(2)
  signupBonus        Int      @default(10)
  verificationBonus  Int      @default(20)
  isUpgradeEnabled   Boolean  @default(false)
  googleClientId     String?
  googleClientSecret String?
  updatedAt          DateTime @updatedAt

  @@map("global_settings")
}

model ShopItem {
  id           String         @id @default(uuid())
  name         String
  description  String?
  type         ItemType
  amount       Int
  price        Int
  durationDays Int            @default(30)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  purchases    UserPurchase[]

  @@map("shop_items")
}

model UserPurchase {
  id         String   @id @default(uuid())
  userId     String
  itemId     String
  type       ItemType
  slotAmount Int
  price      Int
  startDate  DateTime @default(now())
  endDate    DateTime
  createdAt  DateTime @default(now())
  item       ShopItem @relation(fields: [itemId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endDate])
  @@map("user_purchases")
}

model TokenPackage {
  id          String    @id @default(uuid())
  name        String
  tokenAmount Int
  price       Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]

  @@map("token_packages")
}

model Payment {
  id          String        @id @default(uuid())
  userId      String
  packageId   String?
  impUid      String        @unique
  merchantUid String        @unique
  amount      Int
  status      PaymentStatus @default(READY)
  paidAt      DateTime?
  failedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  package     TokenPackage? @relation(fields: [packageId], references: [id])
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum UserRole {
  USER
  ADMIN
}

enum SiteType {
  WORDPRESS
  BLOGSPOT
}

enum PromptType {
  SYSTEM
  USER
}

enum ImageSource {
  DALLE
  FLUX
  SCRAP
  NONE
}

enum AIModel {
  GPT4O
  GEMINI
  CLAUDE
  GPT5
}

enum PostStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum TransactionType {
  CHARGE
  USAGE
  BONUS
  REFUND
  PURCHASE
}

enum ItemType {
  SITE_SLOT
  KEYWORD_SLOT
  PROMPT_SLOT
  TASK_SLOT
}

enum PaymentStatus {
  READY
  PAID
  FAILED
  CANCELLED
}
